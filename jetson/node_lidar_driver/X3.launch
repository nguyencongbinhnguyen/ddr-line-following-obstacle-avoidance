<launch>
  <node name="ydlidar_lidar_publisher"  pkg="ydlidar_ros_driver"  type="ydlidar_ros_driver_node" output="screen" respawn="false" >
    <param name="port"         type="string" value="/dev/lidar"/>  
    <param name="baudrate"     type="int"    value="115200"/>
    <param name="frame_id"     type="string" value="laser_frame"/>
    
    <param name="isSingleChannel"     type="bool"   value="true"/>
    <param name="support_motor_dtr"   type="bool"   value="true"/>
    <param name="device_type"         type="int"    value="0"/>  
    <param name="sample_rate"         type="int"    value="4"/>

    <param name="scan_radius" value="0.7"/>
  </node>
  
  <node pkg="tf" type="static_transform_publisher" name="base_link_to_laser4"
    args="0.0 0.0 0.2 0.0 0.0 0.0 /base_link /laser_frame 40" />
  <node name="rviz" pkg="rviz" type="rviz"
      args="-d $(find ydlidar_ros_driver)/launch/X3.rviz" />
</launch>